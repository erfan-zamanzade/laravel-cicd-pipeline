# Local development defaults. Nothing here is a secret: the database password
# only protects a throwaway container bound to this machine.
APP_NAME=laravel-cicd-pipeline
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=app-local-only

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
METRICS_STORE=redis
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
